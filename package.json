{
  "name": "homebridge-pro1-thermostat",
  "displayName": "Pro1 Thermostat",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Homebridge plugin for Pro1 WiFi thermostats (T701 / T705 / T721 / T755).",
  "author": "Evan Ribbey",
  "license": "Apache-2.0",
  "homepage": "https://git.ribbey.net/evan/homebridge-pro1-thermostat#readme",
  "repository": {
    "type": "git",
    "url": "https://git.ribbey.net/evan/homebridge-pro1-thermostat.git"
  },
  "bugs": {
    "url": "https://git.ribbey.net/evan/homebridge-pro1-thermostat/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "thermostat",
    "pro1",
    "homekit"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "rimraf dist-test && tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
