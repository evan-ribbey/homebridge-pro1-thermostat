{
  "name": "homebridge-pro1-thermostat",
  "displayName": "Pro1 Thermostat",
  "type": "module",
  "version": "0.2.5",
  "description": "Homebridge plugin for Pro1 WiFi thermostats (T701 / T705 / T721 / T755).",
  "author": "Evan Ribbey",
  "license": "Apache-2.0",
  "homepage": "https://github.com/evan-ribbey/homebridge-pro1-thermostat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evan-ribbey/homebridge-pro1-thermostat.git"
  },
  "bugs": {
    "url": "https://github.com/evan-ribbey/homebridge-pro1-thermostat/issues"
  },
  "funding": {
    "type": "kofi",
    "url": "https://ko-fi.com/eribbey"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "thermostat",
    "pro1",
    "homekit"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "certs",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "homebridge": {
    "pluginType": "platform",
    "schema": "config.schema.json"
  },
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "rimraf dist-test && tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "check:pack": "npm pack --dry-run --json | node scripts/check-package-contents.mjs",
    "prepublishOnly": "test -z \"$(git status --porcelain)\" || { echo 'Refusing to publish: uncommitted changes.' >&2; exit 1; }; npm run lint && npm test && npm run build && npm run check:pack",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "amazon-cognito-identity-js": "^6.3.20",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "mqtt": "^5.15.2"
  }
}
